{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.hasChildren(['name','phone','email','setupDone'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "phone": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "setupDone": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'meshaidalertsos@gmail.com'"
      }
    },
    "phoneIndex": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null"
      }
    },
    "directory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "config": {
      ".read": "auth != null",
      "center": {
        ".write": "auth != null && auth.token.email === 'meshaidalertsos@gmail.com'"
      }
    },
    "incidents": {
      ".read": "auth != null",
      "$id": {
        ".read": "auth != null",
        "report": {
          ".write": "auth != null"
        },
        "ops": {
          ".write": "auth != null"
        }
      }
    },
    "tracks": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "relay": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "records": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "disasters": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "checkins": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "helpRequests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "helpResponses": {
      "$id": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null"
        }
      }
    },
    "msgs": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        "$m": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
          }
        }
      }
    },
    "broadcasts": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "dm": {
      ".read": "auth != null",
      "$thread": {
        ".read": "auth != null",
        "$m": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
          }
        }
      }
    },
    "dmIndex": {
      "$a": {
        ".read": "auth != null",
        "$b": {
          ".write": "auth != null"
        }
      }
    },
    "community": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['type','uid','text','ts'])",
        "type": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString()"
        },
        "area": {
          ".validate": "newData.isString()"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "hidden": {
          ".write": "auth != null",
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        },
        "uid": {
          ".validate": "newData.isString()"
        }
      }
    },
    "communityComments": {
      ".read": "auth != null",
      "$postId": {
        "$cid": {
          ".write": "auth != null && (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid','text','ts'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString()"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "bloodRequests": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "reports": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "facilityReports": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "facilities": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "_ping": {
      ".read": true,
      ".write": true
    },
    "bloodResponses": {
      ".read": "auth != null",
      "$id": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null"
        }
      }
    },
    "incidentReports": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "sightings": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },
    "stats": {
      ".read": "auth != null",
      "latest": {
        ".write": "auth != null"
      }
    },
    "audit": {
      ".read": "auth != null && auth.token.email === 'meshaidalertsos@gmail.com'",
      "$id": {
        ".write": "auth != null"
      }
    },
    "centerKeyBackup": {
      ".read": "auth != null && auth.token.email === 'meshaidalertsos@gmail.com'",
      ".write": "auth != null && auth.token.email === 'meshaidalertsos@gmail.com'"
    },
    "medicines": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    }
  }
}