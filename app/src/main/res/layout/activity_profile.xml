<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted" />

        <TextView
            style="@style/AidSection"
            android:text="PUBLIC PROFILE" />

        <EditText
            android:id="@+id/editArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Area / city"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/editBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Short bio"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSearchable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Let other users find my profile" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchShowPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show my phone number on my profile" />

        <TextView
            style="@style/AidSection"
            android:text="MEDICAL (shared with responders only)" />

        <EditText
            android:id="@+id/editBlood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Blood group (e.g. B+)"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/editMedical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Allergies, conditions, medicines"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchMedical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attach medical info to my SOS" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save profile" />
    </LinearLayout>
</ScrollView>
