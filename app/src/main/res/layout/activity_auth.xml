<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                layout="@layout/include_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Be Safe. Stay Connected."
                android:textColor="#FFFFFFFF"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:shadowDy="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sheet_white"
                android:minHeight="480dp"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- LOGIN SECTION -->
                <LinearLayout
                    android:id="@+id/secLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/AidSection" android:text="LOG IN" />

                    <RadioGroup
                        android:id="@+id/radioRole"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/radioCitizen" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="Citizen" />
                        <RadioButton android:id="@+id/radioCenter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Control center" />
                    </RadioGroup>

                    <EditText
                        android:id="@+id/editLoginEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress" />

                    <EditText
                        android:id="@+id/editLoginPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:importantForAutofill="no"
                        android:inputType="textPassword" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Log in" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleLogin"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sign in with Google" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGithubLogin"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sign in with GitHub" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForgot"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Forgot password" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowRegister"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Create a new account" />
                </LinearLayout>

                <!-- REGISTER SECTION -->
                <LinearLayout
                    android:id="@+id/secRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/AidSection" android:text="CREATE ACCOUNT" />

                    <EditText
                        android:id="@+id/editRegName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full name"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName" />

                    <EditText
                        android:id="@+id/editRegEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email address"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress" />

                    <EditText
                        android:id="@+id/editRegPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password (8+ chars)"
                        android:importantForAutofill="no"
                        android:inputType="textPassword" />

                    <EditText
                        android:id="@+id/editRegPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mobile number (Mandatory, e.g. 01712345678)"
                        android:importantForAutofill="no"
                        android:inputType="phone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Create Account" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleRegister"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sign up with Google" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGithubRegister"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sign up with GitHub" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackLogin"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="I already have an account" />
                </LinearLayout>

                <!-- SOCIAL LOGIN PHONE PROMPT SECTION -->
                <LinearLayout
                    android:id="@+id/secSocialPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/AidSection" android:text="NAME &amp; MOBILE NUMBER" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Please provide your name and mobile number to complete your account setup."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/editSocialName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Full name"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName" />

                    <EditText
                        android:id="@+id/editSocialPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Mobile number, e.g. 01712345678"
                        android:importantForAutofill="no"
                        android:inputType="phone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitSocialPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Complete Sign Up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackFromSocialPhone"
                        style="@style/AidButtonOutlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Back to log in" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDirectory"
                    style="@style/AidButtonOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Emergency numbers and nearby help (no login)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Your location is only collected when you trigger an SOS or choose to share it. Passwords are handled by Firebase Authentication and are never stored by this app."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
