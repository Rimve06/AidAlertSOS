<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="3dp"
                android:insetRight="3dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="All"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fEmergency"
                style="@style/AidButtonOutlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="3dp"
                android:insetRight="3dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Disaster &amp; weather"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fWeather"
                style="@style/AidButtonOutlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="3dp"
                android:insetRight="3dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Earthquake"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fHealth"
                style="@style/AidButtonOutlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="3dp"
                android:insetRight="3dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Health"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fLaw"
                style="@style/AidButtonOutlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="3dp"
                android:insetRight="3dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Law &amp; order"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fNews"
                style="@style/AidButtonOutlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="3dp"
                android:insetRight="3dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Safety news"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fIntl"
                style="@style/AidButtonOutlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="3dp"
                android:insetRight="3dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="World"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            style="@style/AidButtonOutlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:text="Refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegion"
            style="@style/AidButtonOutlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:text="Region" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSources"
            style="@style/AidButtonOutlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:text="Official sources" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="@color/text_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1" />
</LinearLayout>
