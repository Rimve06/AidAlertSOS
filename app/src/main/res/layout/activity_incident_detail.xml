<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtHead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F3E5F5"
            android:padding="10dp"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.aidalert.sos.view.MapView
            android:id="@+id/mapOne"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/AidSection"
            android:text="1. CONFIRM WITH THE USER" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Acknowledge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Call user" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Chat with user" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Confirmed real" />
        </GridLayout>

        <TextView
            style="@style/AidSection"
            android:text="2. SEND HELP TO THE LOCATION" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmbulance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Ambulance" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFireSvc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Fire service" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPolice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Police" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRescue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="National rescue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelpers"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Ask nearby helpers" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapApp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Open in Maps" />
        </GridLayout>

        <TextView
            style="@style/AidSection"
            android:text="3. CLOSE" />

        <EditText
            android:id="@+id/editNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Note for the record / for the user"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResolve"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="Resolved" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFalse"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                android:text="False alarm" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
