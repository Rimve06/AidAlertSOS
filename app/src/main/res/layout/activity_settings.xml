<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/AidSection"
            android:text="TRIGGERS" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchGuard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guard on (power x5 and volume holds)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Call automatically on SOS" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchRelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline relay: carry encrypted alerts for other phones" />

        <TextView
            style="@style/AidSection"
            android:text="NUMBER TO CALL ON SOS (empty = control center, then 999)" />

        <EditText
            android:id="@+id/editCallNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 999"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <TextView
            style="@style/AidSection"
            android:text="SERVER" />

        <EditText
            android:id="@+id/editServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Firebase Realtime Database URL"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            android:id="@+id/txtCenterInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPerms"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions checklist" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSync"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync now" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log out" />
    </LinearLayout>
</ScrollView>
