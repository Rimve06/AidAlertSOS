<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF4E5"
        android:padding="10dp"
        android:text="Not a therapist and not an emergency service. In danger, call 999."
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMood"
            style="@style/AidButtonOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I feel..." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelplines"
            style="@style/AidButtonOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Helplines" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalm"
            style="@style/AidButtonOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calm down" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetHelp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Get a person now" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/editMsg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type here"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send" />
    </LinearLayout>
</LinearLayout>
